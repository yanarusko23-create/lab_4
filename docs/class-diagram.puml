@startuml
!theme plain

' ====================================================
' Діаграма класів системи «Інтернет-блог»
' Лабораторна робота №3 з курсу "Теорія програмних систем"
' Виконала: студ. гр. ІСТ-31 Руско Я.М.
' ====================================================

class Блог {
+назва: String
+опис: String
+датаСтворення: Date
+мова: String
+статус: String
+отримативласника(): Автор
+отриматиСтатистику(): Statistics
+змінитиНалаштування(settings: Settings): void
+опублікувати(): void
+архівувати(): void
}

class Автор {
+імяКористувача: String
+email: String
+пароль: String
+датаРеєстрації: Date
+аватар: String
+створитиПост(title: String): Post
+редагуватиПрофіль(data: ProfileData): void
+підписатисяНаБлог(blog: Blog): void
+переглянутиСтатистику(): Statistics
+вийтиЗСистеми(): void
}

class Пост {
+заголовок: String
+текст: String
+датаПублікації: Date
+статус: String
+кількістьПереглядів: Int
+опублікувати(): void
+редагувати(content: String): void
+видалити(): void
+додатиТег(tag: Tag): void
+отриматиКоментарі(): List
}

class Коментар {
+текст: String
+датаСтворення: Date
+відредагований: Boolean
+лайки: Int
+рейтинг: Float
+відповісти(text: String): Comment
+редагувати(text: String): void
+видалити(): void
+поставитиЛайк(): void
+поскаржитись(reason: String): void
}

class Категорія {
+назва: String
+slug: String
+опис: String
+колір: String
+іконка: String
+отриматиПости(): List
+оновити(name: String): void
+видалити(): void
+порахуватиПости(): Int
+отриматиПідкатегорії(): List
}

class Тег {
+назва: String
+slug: String
+кількістьВикористань: Int
+кольорФону: String
+популярність: Float
+отриматиПости(): List
+оновитиНазву(name: String): void
+видалити(): void
+злитиЗТегом(tag: Tag): void
+розрахуватиПопулярність(): Float
}

class Зображення {
+url: String
+alt: String
+розмір: Int
+формат: String
+ширина: Int
+завантажити(file: File): void
+видалити(): void
+змінитиРозмір(w: Int, h: Int): void
+отриматиMeta(): ImageMeta
+оптимізувати(): void
}

class Підписка {
+датаПідписки: Date
+типСповіщень: String
+активна: Boolean
+частота: String
+каналСповіщення: String
+активувати(): void
+деактивувати(): void
+змінитиНалаштування(settings: Settings): void
+отриматиІсторію(): List
+перевіритиСтатус(): Boolean
}

class Читач {
+імяКористувача: String
+email: String
+датаРеєстрації: Date
+аватар: String
+мова: String
+залишитиКоментар(post: Post, text: String): Comment
+підписатися(blog: Blog): Subscription
+вподобатиПост(post: Post): void
+поділитися(post: Post, platform: String): void
+пошукПостів(query: String): List
}

class Статистика {
+загальнихПереглядів: Int
+унікальніВідвідувачі: Int
+середнійЧасНаСторінці: Float
+відсотокВідмов: Float
+топПости: List
+сформуватиЗвіт(period: String): Report
+отриматиТрафік(): TrafficData
+порівняти(period1: String, period2: String): Comparison
+експортувати(format: String): File
+оновити(): void
}

class ПреміумАвтор {
+рівеньПідписки: String
+датаОновлення: Date
+монетизація: Boolean
+лімітПостів: Int
+підтримка: String
+отриматиДоходи(): Float
+активуватиМонетизацію(): void
+переглянутиАналітику(): Analytics
+змінитиПлан(plan: String): void
+отриматиПремiumФункції(): List
}

' Відношення:
Блог "1" *-- "0..*" Пост : містить
Блог "1" *-- "1" Статистика : включає
Автор "1" o-- "0..*" Пост : публікує
Пост "1" --> "0..*" Коментар : має
Пост "0..*" --> "1" Категорія : належить
Пост "0..*" --> "0..*" Тег : позначений
Пост "1" o-- "0..*" Зображення : містить
Читач "0..*" --> "0..*" Блог : підписується
Читач "1" --> "0..*" Підписка : оформлює
ПреміумАвтор --|> Автор : наслідує

@enduml
